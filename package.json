{
  "name": "afrodit-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:images && vite",
    "build": "npm run build:images && tsc -b && vite build && npm run build:ssr && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "build:spa": "tsc -b && vite build",
    "build:images": "node scripts/images.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
